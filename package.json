{
  "name": "tool-truth",
  "version": "0.5.2",
  "description": "Flags AI agent answers that state facts their tools never returned, especially after a tool quietly failed.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "score": "tsx src/cli.ts score",
    "check": "tsx src/cli.ts check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "study": "tsx study/tau-bench.ts"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "3.2.7"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tool-truth": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
